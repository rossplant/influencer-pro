# Optional and unused. main.py does not read these.
# Notion is not the database.
# NOTION_TOKEN=
# NOTION_PRODUCTS_DB=
# NOTION_INFLUENCERS_DB=

# Postgres connection string. Railway's plugin value is usually postgres://...
# The API rewrites that to postgresql+psycopg://. Leave this empty to boot
# with the in-memory fallback (data is lost on restart). The URL is not logged.
# On startup the API runs `alembic upgrade head` itself. No pre-deploy command.
DATABASE_URL=

SHOPIFY_STORE=
SHOPIFY_TOKEN=

# Optional: Grok / xAI. Enrichment falls back locally when no key is set.
GROK_API_KEY=
GROK_MODEL=grok-4.3
# XAI_API_KEY= is also accepted as the key.
# XAI_MODEL=grok-4.3

# Comma-separated. Protected routes accept a matching X-API-Key or an admin session.
# GET /, the creator onboarding pages, POST /onboard-influencer, /docs, and
# /openapi.json stay public. In production and staging (ENV or
# RAILWAY_ENVIRONMENT_NAME is production or staging), protected routes return
# 401 when API_KEYS is unset and there is no admin session.
API_KEYS=

# Required for the admin area. The password is not an env var: open /admin/setup
# while ADMIN_SETUP_TOKEN is set and no admin user exists. Remove the token
# after setup. ADMIN_PASSWORD_HASH is an optional scrypt or bcrypt fallback.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_SETUP_TOKEN=
# ADMIN_PASSWORD_HASH=

# Public origin for Checkout, portal return URLs, and tracking links.
# Required behind Railway, which otherwise sees http.
PUBLIC_BASE_URL=
# Stripe Billing sandbox. Leave unset and the app still starts.
# Never put a live key here. The setup script reads only STRIPE_SECRET_KEY_TEST.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY_TEST=
# Prices are shown ex GST. Stripe Tax stays off.
STRIPE_TAX_DISPLAY=exclusive
# Optional pilot overrides. The free pilot is 2 months from 20 Nov 2026.
# PILOT_MONTHS=2
# PILOT_START=2026-11-20
# PILOT_SELLER_SEATS=10
# PILOT_CURATOR_SEATS=50
# PILOT_CONVERSION_TARGET=0.30
# Tracking is off until TRACKING_ENABLED=1. Production ignores pixel ids.
# TRACKING_ENABLED=
# TIKTOK_PIXEL_ID=
# TIKTOK_EVENTS_API_TOKEN=
# META_PIXEL_ID=
# META_CAPI_TOKEN=
# TIKTOK_TEST_EVENT_CODE=
# META_TEST_EVENT_CODE=
# GOOGLE_TAG_ENABLED=
# PINTEREST_CAPI_ENABLED=
# LINKEDIN_CAPI_ENABLED=
# Email is logged only until a provider is connected. Nothing is sent.
# EMAIL_PROVIDER=

# Comma-separated browser origins. Unset means same-origin only.
# A literal * is never combined with credentialed cookies.
CORS_ORIGINS=

# Reject request bodies larger than this many bytes (default 1048576).
MAX_BODY_BYTES=1048576

# In-memory limit for the guarded API routes. A valid API key has its own
# bucket; requests without one share a per-IP bucket.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
