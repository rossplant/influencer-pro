# Optional and unused. main.py does not read these.
# Notion is not the database. Postgres is the planned system of record.
# NOTION_TOKEN=
# NOTION_PRODUCTS_DB=
# NOTION_INFLUENCERS_DB=

SHOPIFY_STORE=
SHOPIFY_TOKEN=

# Optional: Grok / xAI. Enrichment falls back locally when no key is set.
GROK_API_KEY=
GROK_MODEL=grok-4.3
# XAI_API_KEY= is also accepted as the key.
# XAI_MODEL=grok-4.3

# Comma-separated. Leave empty and the API routes stay open.
# When set, /enrich, /match, /onboard-influencer, and /sync-shopify
# require an X-API-Key header. GET / stays public.
API_KEYS=

# Comma-separated browser origins, or *. Read when the process starts.
CORS_ORIGINS=*

# Reject request bodies larger than this many bytes (default 1048576).
MAX_BODY_BYTES=1048576

# In-memory limit for the guarded API routes. A valid API key has its own
# bucket; requests without one share a per-IP bucket.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
